PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lumora
DB_NAME=main
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# ── Email OTP (Gmail API through Google Cloud OAuth2 + nodemailer) ──
# Leave these empty while developing: the 6-digit code is then printed in this server's console.
GMAIL_USER=yourname@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
OTP_MINUTES=10
# true = a code is emailed on EVERY login (and always on sign-up). false = only unverified accounts need one.
LOGIN_OTP=true

# ── Music library (free key from https://devportal.jamendo.com → create an app → copy the Client ID) ──
JAMENDO_CLIENT_ID=

# ── File storage: REQUIRED on Render (its disk is erased on every restart). Free account at https://cloudinary.com
# Either the three values below, or just CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Leave empty on your own PC to keep files in server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Device push notifications (Web Push). Generate once with:  node scripts/vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
